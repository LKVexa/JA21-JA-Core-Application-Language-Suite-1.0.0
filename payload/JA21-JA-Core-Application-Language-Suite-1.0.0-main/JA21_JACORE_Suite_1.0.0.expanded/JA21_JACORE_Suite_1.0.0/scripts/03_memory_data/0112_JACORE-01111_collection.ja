module corpus.ja_core.example_01111
use Core
policy no_network

record Item46 { id: Count, label: Text }
function transform_46(item: Item46) -> Result<Item46, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item46 { id: item.id, label: normalized })
}
let sample: Item46 = Item46 { id: 46, label: "collection-intermediate" }
let result = transform_46(sample)
assert result.is_ok == true
emit json result
