module corpus.ja_core.example_09733
use Core
policy no_network

record Item35 { id: Count, label: Text }
function transform_35(item: Item35) -> Result<Item35, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item35 { id: item.id, label: normalized })
}
let sample: Item35 = Item35 { id: 35, label: "borrow-deployment" }
let result = transform_35(sample)
assert result.is_ok == true
emit json result
