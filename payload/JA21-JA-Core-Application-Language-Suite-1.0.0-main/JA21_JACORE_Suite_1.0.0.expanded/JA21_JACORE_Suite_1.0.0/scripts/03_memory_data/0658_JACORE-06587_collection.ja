module corpus.ja_core.example_06587
use Core
policy no_network

record Item90 { id: Count, label: Text }
function transform_90(item: Item90) -> Result<Item90, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item90 { id: item.id, label: normalized })
}
let sample: Item90 = Item90 { id: 90, label: "collection-optimization" }
let result = transform_90(sample)
assert result.is_ok == true
emit json result
