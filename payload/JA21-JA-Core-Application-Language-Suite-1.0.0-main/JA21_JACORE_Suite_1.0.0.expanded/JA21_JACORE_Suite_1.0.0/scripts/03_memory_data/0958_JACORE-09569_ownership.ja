module corpus.ja_core.example_09569
use Core
policy no_network

record Item65 { id: Count, label: Text }
function transform_65(item: Item65) -> Result<Item65, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item65 { id: item.id, label: normalized })
}
let sample: Item65 = Item65 { id: 65, label: "ownership-deployment" }
let result = transform_65(sample)
assert result.is_ok == true
emit json result
