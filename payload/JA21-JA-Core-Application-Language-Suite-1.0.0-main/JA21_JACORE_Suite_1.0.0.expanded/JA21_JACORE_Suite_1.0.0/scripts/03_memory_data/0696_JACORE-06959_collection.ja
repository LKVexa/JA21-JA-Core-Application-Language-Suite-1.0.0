module corpus.ja_core.example_06959
use Core
policy no_network

record Item74 { id: Count, label: Text }
function transform_74(item: Item74) -> Result<Item74, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item74 { id: item.id, label: normalized })
}
let sample: Item74 = Item74 { id: 74, label: "collection-optimization" }
let result = transform_74(sample)
assert result.is_ok == false
emit json result
