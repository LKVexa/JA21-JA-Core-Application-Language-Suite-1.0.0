module corpus.ja_core.example_03456
use Core
policy no_network

record Item63 { id: Count, label: Text }
function transform_63(item: Item63) -> Result<Item63, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item63 { id: item.id, label: normalized })
}
let sample: Item63 = Item63 { id: 63, label: "lifetime-expert" }
let result = transform_63(sample)
assert result.is_ok == false
emit json result
