module corpus.ja_core.example_08312
use Core
policy no_network

record Item69 { id: Count, label: Text }
function transform_69(item: Item69) -> Result<Item69, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item69 { id: item.id, label: normalized })
}
let sample: Item69 = Item69 { id: 69, label: "lifetime-certification" }
let result = transform_69(sample)
assert result.is_ok == true
emit json result
