module corpus.ja_core.example_00428
use Core
policy no_network

record Item42 { id: Count, label: Text }
function transform_42(item: Item42) -> Result<Item42, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item42 { id: item.id, label: normalized })
}
let sample: Item42 = Item42 { id: 42, label: "borrow-beginner" }
let result = transform_42(sample)
assert result.is_ok == false
emit json result
