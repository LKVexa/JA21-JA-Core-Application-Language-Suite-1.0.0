module corpus.ja_core.example_03686
use Core
policy no_network

record Item2 { id: Count, label: Text }
function transform_2(item: Item2) -> Result<Item2, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item2 { id: item.id, label: normalized })
}
let sample: Item2 = Item2 { id: 2, label: "ownership-expert" }
let result = transform_2(sample)
assert result.is_ok == true
emit json result
