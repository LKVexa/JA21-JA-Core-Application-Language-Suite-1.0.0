module corpus.ja_core.example_09637
use Core
policy no_network

record Item36 { id: Count, label: Text }
function transform_36(item: Item36) -> Result<Item36, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item36 { id: item.id, label: normalized })
}
let sample: Item36 = Item36 { id: 36, label: "collection-deployment" }
let result = transform_36(sample)
assert result.is_ok == true
emit json result
