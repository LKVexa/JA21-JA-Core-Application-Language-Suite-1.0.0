module corpus.ja_core.example_04741
use Core
policy no_network

record Item87 { id: Count, label: Text }
function transform_87(item: Item87) -> Result<Item87, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item87 { id: item.id, label: normalized })
}
let sample: Item87 = Item87 { id: 87, label: "serialization-compiler" }
let result = transform_87(sample)
assert result.is_ok == true
emit json result
