module corpus.ja_core.example_08963
use Core
policy no_network

record Item41 { id: Count, label: Text }
function transform_41(item: Item41) -> Result<Item41, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item41 { id: item.id, label: normalized })
}
let sample: Item41 = Item41 { id: 41, label: "lifetime-certification" }
let result = transform_41(sample)
assert result.is_ok == false
emit json result
