module corpus.ja_core.example_07422
use Core
policy no_network

record Item52 { id: Count, label: Text }
function transform_52(item: Item52) -> Result<Item52, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item52 { id: item.id, label: normalized })
}
let sample: Item52 = Item52 { id: 52, label: "ownership-validation" }
let result = transform_52(sample)
assert result.is_ok == false
emit json result
