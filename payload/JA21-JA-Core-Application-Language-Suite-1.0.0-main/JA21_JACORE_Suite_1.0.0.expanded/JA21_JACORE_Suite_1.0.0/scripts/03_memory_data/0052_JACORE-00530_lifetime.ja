module corpus.ja_core.example_00530
use Core
policy no_network

record Item47 { id: Count, label: Text }
function transform_47(item: Item47) -> Result<Item47, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item47 { id: item.id, label: normalized })
}
let sample: Item47 = Item47 { id: 47, label: "lifetime-beginner" }
let result = transform_47(sample)
assert result.is_ok == false
emit json result
