module corpus.ja_core.example_01433
use Core
policy no_network

record Item77 { id: Count, label: Text }
function transform_77(item: Item77) -> Result<Item77, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item77 { id: item.id, label: normalized })
}
let sample: Item77 = Item77 { id: 77, label: "lifetime-intermediate" }
let result = transform_77(sample)
assert result.is_ok == false
emit json result
