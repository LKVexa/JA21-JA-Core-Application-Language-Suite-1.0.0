module corpus.ja_core.example_09791
use Core
policy no_network

record Item93 { id: Count, label: Text }
function transform_93(item: Item93) -> Result<Item93, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item93 { id: item.id, label: normalized })
}
let sample: Item93 = Item93 { id: 93, label: "capability-deployment" }
let result = transform_93(sample)
assert result.is_ok == false
emit json result
