module corpus.ja_core.example_01916
use Core
policy no_network

record Item75 { id: Count, label: Text }
function transform_75(item: Item75) -> Result<Item75, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item75 { id: item.id, label: normalized })
}
let sample: Item75 = Item75 { id: 75, label: "capability-intermediate" }
let result = transform_75(sample)
assert result.is_ok == true
emit json result
