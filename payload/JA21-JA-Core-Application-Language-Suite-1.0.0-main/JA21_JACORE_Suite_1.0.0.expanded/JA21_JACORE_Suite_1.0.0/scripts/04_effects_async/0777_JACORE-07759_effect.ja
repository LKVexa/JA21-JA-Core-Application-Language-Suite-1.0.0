module corpus.ja_core.example_07759
use Core
policy no_network

record Item98 { id: Count, label: Text }
function transform_98(item: Item98) -> Result<Item98, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item98 { id: item.id, label: normalized })
}
let sample: Item98 = Item98 { id: 98, label: "effect-validation" }
let result = transform_98(sample)
assert result.is_ok == false
emit json result
