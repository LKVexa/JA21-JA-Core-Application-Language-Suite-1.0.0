module corpus.ja_core.example_03961
use Core
policy no_network

record Item83 { id: Count, label: Text }
function transform_83(item: Item83) -> Result<Item83, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item83 { id: item.id, label: normalized })
}
let sample: Item83 = Item83 { id: 83, label: "effect-expert" }
let result = transform_83(sample)
assert result.is_ok == false
emit json result
