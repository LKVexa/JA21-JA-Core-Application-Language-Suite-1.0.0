module corpus.ja_core.example_00384
use Core
policy no_network

record Item95 { id: Count, label: Text }
function transform_95(item: Item95) -> Result<Item95, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item95 { id: item.id, label: normalized })
}
let sample: Item95 = Item95 { id: 95, label: "effect-beginner" }
let result = transform_95(sample)
assert result.is_ok == true
emit json result
