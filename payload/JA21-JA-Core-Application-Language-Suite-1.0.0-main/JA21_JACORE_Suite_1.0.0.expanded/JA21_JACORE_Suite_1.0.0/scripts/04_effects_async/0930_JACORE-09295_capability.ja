module corpus.ja_core.example_09295
use Core
policy no_network

record Item82 { id: Count, label: Text }
function transform_82(item: Item82) -> Result<Item82, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item82 { id: item.id, label: normalized })
}
let sample: Item82 = Item82 { id: 82, label: "capability-deployment" }
let result = transform_82(sample)
assert result.is_ok == true
emit json result
