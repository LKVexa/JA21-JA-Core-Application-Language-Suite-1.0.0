module corpus.ja_core.example_03517
use Core
policy no_network

record Item27 { id: Count, label: Text }
function transform_27(item: Item27) -> Result<Item27, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item27 { id: item.id, label: normalized })
}
let sample: Item27 = Item27 { id: 27, label: "option-expert" }
let result = transform_27(sample)
assert result.is_ok == false
emit json result
