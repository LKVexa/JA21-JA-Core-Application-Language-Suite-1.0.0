module corpus.ja_core.example_07040
use Core
policy no_network

record Item58 { id: Count, label: Text }
function transform_58(item: Item58) -> Result<Item58, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item58 { id: item.id, label: normalized })
}
let sample: Item58 = Item58 { id: 58, label: "generic-validation" }
let result = transform_58(sample)
assert result.is_ok == true
emit json result
