module corpus.ja_core.example_01599
use Core
policy no_network

record Item49 { id: Count, label: Text }
function transform_49(item: Item49) -> Result<Item49, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item49 { id: item.id, label: normalized })
}
let sample: Item49 = Item49 { id: 49, label: "function-intermediate" }
let result = transform_49(sample)
assert result.is_ok == true
emit json result
