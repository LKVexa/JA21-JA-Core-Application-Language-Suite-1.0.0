module corpus.ja_core.example_05026
use Core
policy no_network

record Item81 { id: Count, label: Text }
function transform_81(item: Item81) -> Result<Item81, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item81 { id: item.id, label: normalized })
}
let sample: Item81 = Item81 { id: 81, label: "trait-runtime" }
let result = transform_81(sample)
assert result.is_ok == true
emit json result
