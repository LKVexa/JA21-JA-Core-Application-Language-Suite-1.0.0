module corpus.ja_core.example_07700
use Core
policy no_network

record Item39 { id: Count, label: Text }
function transform_39(item: Item39) -> Result<Item39, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item39 { id: item.id, label: normalized })
}
let sample: Item39 = Item39 { id: 39, label: "trait-validation" }
let result = transform_39(sample)
assert result.is_ok == true
emit json result
