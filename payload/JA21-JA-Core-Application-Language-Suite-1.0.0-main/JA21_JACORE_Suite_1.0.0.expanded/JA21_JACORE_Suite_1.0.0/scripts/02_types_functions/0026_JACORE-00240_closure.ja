module corpus.ja_core.example_00240
use Core
policy no_network

record Item48 { id: Count, label: Text }
function transform_48(item: Item48) -> Result<Item48, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item48 { id: item.id, label: normalized })
}
let sample: Item48 = Item48 { id: 48, label: "closure-beginner" }
let result = transform_48(sample)
assert result.is_ok == true
emit json result
