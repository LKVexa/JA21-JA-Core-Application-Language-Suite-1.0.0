module corpus.ja_core.example_07049
use Core
policy no_network

record Item67 { id: Count, label: Text }
function transform_67(item: Item67) -> Result<Item67, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item67 { id: item.id, label: normalized })
}
let sample: Item67 = Item67 { id: 67, label: "trait-validation" }
let result = transform_67(sample)
assert result.is_ok == true
emit json result
