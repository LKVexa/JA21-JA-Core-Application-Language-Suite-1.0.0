module corpus.ja_core.example_08528
use Core
policy no_network

record Item91 { id: Count, label: Text }
function transform_91(item: Item91) -> Result<Item91, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item91 { id: item.id, label: normalized })
}
let sample: Item91 = Item91 { id: 91, label: "option-certification" }
let result = transform_91(sample)
assert result.is_ok == false
emit json result
