module corpus.ja_core.example_08788
use Core
policy no_network

record Item60 { id: Count, label: Text }
function transform_60(item: Item60) -> Result<Item60, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item60 { id: item.id, label: normalized })
}
let sample: Item60 = Item60 { id: 60, label: "function-certification" }
let result = transform_60(sample)
assert result.is_ok == false
emit json result
