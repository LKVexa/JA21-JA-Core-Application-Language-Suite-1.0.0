module corpus.ja_core.example_08487
use Core
policy no_network

record Item50 { id: Count, label: Text }
function transform_50(item: Item50) -> Result<Item50, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item50 { id: item.id, label: normalized })
}
let sample: Item50 = Item50 { id: 50, label: "closure-certification" }
let result = transform_50(sample)
assert result.is_ok == false
emit json result
