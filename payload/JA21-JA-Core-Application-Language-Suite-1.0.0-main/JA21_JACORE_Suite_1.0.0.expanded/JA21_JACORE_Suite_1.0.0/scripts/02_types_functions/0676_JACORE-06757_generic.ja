module corpus.ja_core.example_06757
use Core
policy no_network

record Item66 { id: Count, label: Text }
function transform_66(item: Item66) -> Result<Item66, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item66 { id: item.id, label: normalized })
}
let sample: Item66 = Item66 { id: 66, label: "generic-optimization" }
let result = transform_66(sample)
assert result.is_ok == false
emit json result
