module corpus.ja_core.example_00536
use Core
policy no_network

record Item53 { id: Count, label: Text }
function transform_53(item: Item53) -> Result<Item53, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item53 { id: item.id, label: normalized })
}
let sample: Item53 = Item53 { id: 53, label: "package-beginner" }
let result = transform_53(sample)
assert result.is_ok == false
emit json result
