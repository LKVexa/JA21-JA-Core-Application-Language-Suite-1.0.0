module corpus.ja_core.example_09137
use Core
policy no_network

record Item21 { id: Count, label: Text }
function transform_21(item: Item21) -> Result<Item21, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item21 { id: item.id, label: normalized })
}
let sample: Item21 = Item21 { id: 21, label: "immutable_binding-deployment" }
let result = transform_21(sample)
assert result.is_ok == true
emit json result
