module corpus.ja_core.example_08956
use Core
policy no_network

record Item34 { id: Count, label: Text }
function transform_34(item: Item34) -> Result<Item34, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item34 { id: item.id, label: normalized })
}
let sample: Item34 = Item34 { id: 34, label: "constant-certification" }
let result = transform_34(sample)
assert result.is_ok == false
emit json result
