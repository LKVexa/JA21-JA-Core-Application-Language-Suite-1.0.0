module corpus.ja_core.example_07136
use Core
policy no_network

record Item57 { id: Count, label: Text }
function transform_57(item: Item57) -> Result<Item57, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item57 { id: item.id, label: normalized })
}
let sample: Item57 = Item57 { id: 57, label: "package-validation" }
let result = transform_57(sample)
assert result.is_ok == true
emit json result
