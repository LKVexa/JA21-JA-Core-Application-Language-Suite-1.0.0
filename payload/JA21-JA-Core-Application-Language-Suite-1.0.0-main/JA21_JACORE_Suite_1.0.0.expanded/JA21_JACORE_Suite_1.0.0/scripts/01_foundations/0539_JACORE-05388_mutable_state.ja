module corpus.ja_core.example_05388
use Core
policy no_network

record Item55 { id: Count, label: Text }
function transform_55(item: Item55) -> Result<Item55, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item55 { id: item.id, label: normalized })
}
let sample: Item55 = Item55 { id: 55, label: "mutable_state-runtime" }
let result = transform_55(sample)
assert result.is_ok == true
emit json result
