module corpus.ja_core.example_03161
use Core
policy no_network

record Item59 { id: Count, label: Text }
function transform_59(item: Item59) -> Result<Item59, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item59 { id: item.id, label: normalized })
}
let sample: Item59 = Item59 { id: 59, label: "immutable_binding-expert" }
let result = transform_59(sample)
assert result.is_ok == true
emit json result
