module corpus.ja_core.example_04653
use Core
policy no_network

record Item96 { id: Count, label: Text }
function transform_96(item: Item96) -> Result<Item96, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item96 { id: item.id, label: normalized })
}
let sample: Item96 = Item96 { id: 96, label: "immutable_binding-compiler" }
let result = transform_96(sample)
assert result.is_ok == true
emit json result
