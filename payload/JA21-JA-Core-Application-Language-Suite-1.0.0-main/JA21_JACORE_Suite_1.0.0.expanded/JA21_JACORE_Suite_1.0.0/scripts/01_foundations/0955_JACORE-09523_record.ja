module corpus.ja_core.example_09523
use Core
policy no_network

record Item19 { id: Count, label: Text }
function transform_19(item: Item19) -> Result<Item19, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item19 { id: item.id, label: normalized })
}
let sample: Item19 = Item19 { id: 19, label: "record-deployment" }
let result = transform_19(sample)
assert result.is_ok == false
emit json result
