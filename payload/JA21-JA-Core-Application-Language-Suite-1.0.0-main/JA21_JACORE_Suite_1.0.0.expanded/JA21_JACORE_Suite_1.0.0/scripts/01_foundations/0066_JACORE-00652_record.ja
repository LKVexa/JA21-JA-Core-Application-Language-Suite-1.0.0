module corpus.ja_core.example_00652
use Core
policy no_network

record Item72 { id: Count, label: Text }
function transform_72(item: Item72) -> Result<Item72, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item72 { id: item.id, label: normalized })
}
let sample: Item72 = Item72 { id: 72, label: "record-beginner" }
let result = transform_72(sample)
assert result.is_ok == true
emit json result
