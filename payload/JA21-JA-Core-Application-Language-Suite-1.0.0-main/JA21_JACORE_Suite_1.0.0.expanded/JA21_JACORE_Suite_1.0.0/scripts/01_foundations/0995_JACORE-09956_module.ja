module corpus.ja_core.example_09956
use Core
policy no_network

record Item64 { id: Count, label: Text }
function transform_64(item: Item64) -> Result<Item64, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item64 { id: item.id, label: normalized })
}
let sample: Item64 = Item64 { id: 64, label: "module-deployment" }
let result = transform_64(sample)
assert result.is_ok == false
emit json result
