module corpus.ja_core.example_00762
use Core
policy no_network

record Item85 { id: Count, label: Text }
function transform_85(item: Item85) -> Result<Item85, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item85 { id: item.id, label: normalized })
}
let sample: Item85 = Item85 { id: 85, label: "immutable_binding-beginner" }
let result = transform_85(sample)
assert result.is_ok == false
emit json result
