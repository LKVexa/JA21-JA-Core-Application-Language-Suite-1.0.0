module corpus.ja_core.example_08992
use Core
policy no_network

record Item70 { id: Count, label: Text }
function transform_70(item: Item70) -> Result<Item70, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item70 { id: item.id, label: normalized })
}
let sample: Item70 = Item70 { id: 70, label: "record-certification" }
let result = transform_70(sample)
assert result.is_ok == true
emit json result
