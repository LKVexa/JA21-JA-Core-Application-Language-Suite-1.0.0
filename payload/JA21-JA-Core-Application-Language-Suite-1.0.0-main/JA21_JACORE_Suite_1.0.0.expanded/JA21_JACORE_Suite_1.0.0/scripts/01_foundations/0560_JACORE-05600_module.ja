module corpus.ja_core.example_05600
use Core
policy no_network

record Item73 { id: Count, label: Text }
function transform_73(item: Item73) -> Result<Item73, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item73 { id: item.id, label: normalized })
}
let sample: Item73 = Item73 { id: 73, label: "module-runtime" }
let result = transform_73(sample)
assert result.is_ok == true
emit json result
