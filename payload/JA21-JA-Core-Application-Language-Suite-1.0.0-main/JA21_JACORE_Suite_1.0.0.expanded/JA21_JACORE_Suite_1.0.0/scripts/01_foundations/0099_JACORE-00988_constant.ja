module corpus.ja_core.example_00988
use Core
policy no_network

record Item20 { id: Count, label: Text }
function transform_20(item: Item20) -> Result<Item20, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item20 { id: item.id, label: normalized })
}
let sample: Item20 = Item20 { id: 20, label: "constant-beginner" }
let result = transform_20(sample)
assert result.is_ok == true
emit json result
