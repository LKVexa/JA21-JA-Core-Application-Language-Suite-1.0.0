module corpus.ja_core.example_09695
use Core
policy no_network

record Item94 { id: Count, label: Text }
function transform_94(item: Item94) -> Result<Item94, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item94 { id: item.id, label: normalized })
}
let sample: Item94 = Item94 { id: 94, label: "immutable_binding-deployment" }
let result = transform_94(sample)
assert result.is_ok == true
emit json result
