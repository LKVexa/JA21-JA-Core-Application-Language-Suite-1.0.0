module corpus.ja_core.example_03772
use Core
policy no_network

record Item88 { id: Count, label: Text }
function transform_88(item: Item88) -> Result<Item88, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item88 { id: item.id, label: normalized })
}
let sample: Item88 = Item88 { id: 88, label: "package-expert" }
let result = transform_88(sample)
assert result.is_ok == false
emit json result
