module corpus.ja_core.example_07424
use Core
policy no_network

record Item54 { id: Count, label: Text }
function transform_54(item: Item54) -> Result<Item54, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item54 { id: item.id, label: normalized })
}
let sample: Item54 = Item54 { id: 54, label: "immutable_binding-validation" }
let result = transform_54(sample)
assert result.is_ok == false
emit json result
