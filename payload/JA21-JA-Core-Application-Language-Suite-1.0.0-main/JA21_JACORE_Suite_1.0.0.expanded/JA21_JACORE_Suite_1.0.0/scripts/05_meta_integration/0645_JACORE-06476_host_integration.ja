module corpus.ja_core.example_06476
use Core
policy no_network

record Item76 { id: Count, label: Text }
function transform_76(item: Item76) -> Result<Item76, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item76 { id: item.id, label: normalized })
}
let sample: Item76 = Item76 { id: 76, label: "host_integration-optimization" }
let result = transform_76(sample)
assert result.is_ok == false
emit json result
