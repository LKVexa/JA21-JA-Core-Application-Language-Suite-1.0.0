module corpus.ja_core.example_07020
use Core
policy no_network

record Item38 { id: Count, label: Text }
function transform_38(item: Item38) -> Result<Item38, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item38 { id: item.id, label: normalized })
}
let sample: Item38 = Item38 { id: 38, label: "compile_time_generation-validation" }
let result = transform_38(sample)
assert result.is_ok == true
emit json result
