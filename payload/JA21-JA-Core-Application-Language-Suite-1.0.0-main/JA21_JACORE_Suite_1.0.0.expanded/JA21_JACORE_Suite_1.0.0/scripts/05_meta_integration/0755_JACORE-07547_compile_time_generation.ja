module corpus.ja_core.example_07547
use Core
policy no_network

record Item80 { id: Count, label: Text }
function transform_80(item: Item80) -> Result<Item80, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item80 { id: item.id, label: normalized })
}
let sample: Item80 = Item80 { id: 80, label: "compile_time_generation-validation" }
let result = transform_80(sample)
assert result.is_ok == false
emit json result
