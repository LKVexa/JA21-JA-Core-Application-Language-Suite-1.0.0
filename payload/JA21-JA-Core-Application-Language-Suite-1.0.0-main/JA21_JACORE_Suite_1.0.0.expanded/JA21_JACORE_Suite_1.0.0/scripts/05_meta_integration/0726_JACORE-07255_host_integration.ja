module corpus.ja_core.example_07255
use Core
policy no_network

record Item79 { id: Count, label: Text }
function transform_79(item: Item79) -> Result<Item79, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item79 { id: item.id, label: normalized })
}
let sample: Item79 = Item79 { id: 79, label: "host_integration-validation" }
let result = transform_79(sample)
assert result.is_ok == true
emit json result
