module corpus.ja_core.example_03408
use Core
policy no_network

record Item15 { id: Count, label: Text }
function transform_15(item: Item15) -> Result<Item15, Text> effects { pure } {
    let normalized: Text = item.label
    return Ok(Item15 { id: item.id, label: normalized })
}
let sample: Item15 = Item15 { id: 15, label: "compile_time_generation-expert" }
let result = transform_15(sample)
assert result.is_ok == false
emit json result
